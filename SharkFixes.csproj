<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SharkFixes</AssemblyName>
    <Version>1.1.0</Version>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <!-- point this at your game folder -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.steam/steam/steamapps/common/Block Story</GameDir>
    <Managed>$(GameDir)/blockstorylinux_Data/Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="icon.png"><LogicalName>icon.png</LogicalName></EmbeddedResource>
  </ItemGroup>
</Project>
